# ODIN .gitignore
# Prevents sensitive and unnecessary files from being committed to GitHub

# ====================
# Sensitive Data
# ====================
# Never commit API keys or credentials!
Config/user-preferences.yaml
*.key
*.env
.env
.env.local
*.secret

# API key files
api_keys/
secrets/

# ====================
# User Data
# ====================
# User projects (keep template only)
Workspaces/*
!Workspaces/ExampleProject/
!Workspaces/ExampleProject/.odin-meta.yaml

# Logs (keep directory, not content)
Logs/*.log
Logs/*.txt
!Logs/.gitkeep

# ====================
# Python
# ====================
# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
ENV/
env/
.venv

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ====================
# System Files
# ====================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# macOS thumbnails
._*

# macOS Trash
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory

# ====================
# ODIN Specific
# ====================
# Daemon socket
daemon/*.sock
*.sock

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Backup files
*.backup
*.bak
*.old

# Test files (keep test directory structure)
test_output/
temp_tests/

# ====================
# IDE / Editor
# ====================
# VS Code
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# ====================
# Documentation Build
# ====================
docs/_build/
site/

# ====================
# Keep These
# ====================
# Keep empty directories with .gitkeep
!.gitkeep

# Keep example configurations
!Config/models-config.yaml
!Config/odin-config.yaml
!Config/project-index.yaml

# Keep documentation
!*.md
!*.txt
!*.rst

# Keep example project
!Workspaces/ExampleProject/
